{
  "version": 2,
  "framework": null,
  "outputDirectory": "public",
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index.js?path=$1"
    }
  ],
  "functions": {
    "api/index.js": {
      "includeFiles": "data/sample/**",
      "maxDuration": 300
    }
  },
  "crons": [
    {
      "path": "/api/collect",
      "schedule": "0 19 * * *"
    }
  ],
  "regions": [
    "sin1"
  ]
}
