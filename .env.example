# Server-only values. Never expose these to the browser. Never commit .env.

# Supabase (service role key is used server-side only; RLS has no public policies)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Apify. Actors in priority order: each is tried when the one before fails,
# returns nothing or returns only old reviews. One token may serve all.
APIFY_API_TOKEN=
APIFY_ACTOR_ID=apt_marble/booking-reviews-scraper,omkar-cloud/booking-reviews-scraper,scrapeunblocker/booking-reviews-scraper
# Optional: reviews per property per run (default 300) and a forced start
# date for a one-off backfill (default: newest stored review minus 14 days).
APIFY_MAX_REVIEWS=
APIFY_SINCE=
# Optional JSON merged into actor input, flat or keyed by actor id.
APIFY_INPUT_OVERRIDES=

# AI topic tagging. Comma-separated keys per provider.
GROQ_API_KEYS=
OPENROUTER_API_KEYS=

# Protects GET /api/collect (Vercel cron sends it as a Bearer token).
# Leave empty to disable the endpoint (it then returns 503).
CRON_SECRET=

# Optional: dashboard data file used when Supabase is not configured.
# Defaults to data/sample/reviews.json
SAMPLE_DATA_PATH=
