# Server-only values. Never expose these to the browser. Never commit .env.

# Supabase (service role key is used server-side only; RLS has no public policies)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Apify. Comma-separated actor IDs: the first is primary, the rest are fallbacks.
# Tokens pair with actors by position (one token may serve all).
APIFY_API_TOKEN=
APIFY_ACTOR_ID=

# AI topic tagging. Comma-separated keys per provider.
GROQ_API_KEYS=
OPENROUTER_API_KEYS=

# Protects GET /api/collect (Vercel cron sends it as a Bearer token).
# Leave empty to disable the endpoint (it then returns 503).
CRON_SECRET=

# Optional: dashboard data file used when Supabase is not configured.
# Defaults to data/sample/reviews.json
SAMPLE_DATA_PATH=
